def normalize_ocr_text(text):
    """
    STOP / STATION / GOAL처럼 영문 대문자 표식만 필요하므로
    공백/기호 제거 + 자주 생기는 OCR 숫자 오인식 보정.
    """
    s = str(text).upper().strip()

    # 흔한 OCR 오인식 보정
    s = s.replace("0", "O")
    s = s.replace("1", "I")
    s = s.replace("5", "S")

    # 영문자만 남김
    s = re.sub(r"[^A-Z]", "", s)

    return s


def find_ocr_keyword(text):
    s = normalize_ocr_text(text)

    for word in OCR_WORDS:
        if word in s:
            return word

    return None


def submit_ocr_frame(frame):
    """
    control_loop는 절대 OCR 추론을 직접 기다리지 않는다.
    최신 frame만 worker에 넘긴다.
    """
    global latest_ocr_frame

    with ocr_frame_lock:
        latest_ocr_frame = frame.copy()


def clear_ocr_target():
    global latest_ocr_target_full
    global latest_ocr_time
    global latest_ocr_word
    global latest_ocr_score

    with ocr_result_lock:
        latest_ocr_target_full = None
        latest_ocr_time = 0.0
        latest_ocr_word = ""
        latest_ocr_score = 0.0


def get_live_ocr_target(ox, oy):
    """
    OCR worker 결과는 full-frame 좌표다.
    기존 target 구조는 ROI 상대좌표를 쓰므로 변환해서 반환한다.
    """
    with ocr_result_lock:
        target_full = latest_ocr_target_full
        ts = latest_ocr_time

        if target_full is None:
            return None

        if time.time() - ts > OCR_RESULT_TTL:
            return None

        x, y, w, h = target_full["bbox_full"]
        cx, cy = target_full["center_full"]

        return {
            "type": "OCR_TEXT",
            "label": f'OCR:{target_full["word"]}',
            "word": target_full["word"],
            "score": target_full["score"],
            "bbox": (
                int(x - ox),
                int(y - oy),
                int(w),
                int(h)
            ),
            "center": (
                int(cx - ox),
                int(cy - oy)
            ),
            "mask": None,
            "skeleton": None,
            "path": [],
            "follow_point": (
                int(cx - ox),
                int(cy - oy)
            )
        }


def ocr_worker():
    """
    PP-OCR 계열 AI OCR을 별도 thread에서 수행.

    - 기존 이진화는 그대로 유지
    - AI OCR은 STOP / STATION / GOAL만 받아들임
    - 화살표는 기존 skeleton/이진화 검출을 그대로 사용
    """
    global ocr_engine
    global latest_ocr_frame
    global latest_ocr_target_full
    global latest_ocr_time
    global latest_ocr_word
    global latest_ocr_score

    print("[OCR] RapidOCR loading...")

    try:
        # RapidOCR wheel에 포함된 경량 PP-OCR 계열 모델 사용
        ocr_engine = RapidOCR()
        print("[OCR] RapidOCR ready")

    except Exception as e:
        print("[OCR] INIT FAILED:", e)
        return

    while not stop_event.is_set():

        frame = None

        with ocr_frame_lock:
            if latest_ocr_frame is not None:
                frame = latest_ocr_frame
                latest_ocr_frame = None

        if frame is None:
            time.sleep(0.02)
            continue

        try:
            h, w = frame.shape[:2]

            # 기존 아래 50% ROI와 달리 화면 위쪽부터 넓게 확인
            x1 = int(w * OCR_SIDE_RATIO)
            x2 = int(w * (1.0 - OCR_SIDE_RATIO))
            y1 = int(h * OCR_TOP_RATIO)
            y2 = h

            crop = frame[y1:y2, x1:x2]

            if crop.size == 0:
                continue

            # 멀리 있는 작은 글씨를 detector가 보기 쉽게 확대
            ocr_input = cv2.resize(
                crop,
                None,
                fx=OCR_SCALE,
                fy=OCR_SCALE,
                interpolation=cv2.INTER_CUBIC
            )

            # 글씨는 정방향이므로 orientation classifier는 끔
            result = ocr_engine(
                ocr_input,
                use_det=True,
                use_cls=False,
                use_rec=True
            )

            boxes = getattr(result, "boxes", None)
            txts = getattr(result, "txts", None)
            scores = getattr(result, "scores", None)

            if boxes is None or txts is None or scores is None:
                continue

            best = None

            for box, txt, score in zip(boxes, txts, scores):

                score = float(score)

                if score < OCR_MIN_SCORE:
                    continue

                keyword = find_ocr_keyword(txt)

                if keyword is None:
                    continue

                pts = np.asarray(
                    box,
                    dtype=np.float32
                )

                # OCR_INPUT(scale 적용) -> crop 좌표 -> full frame 좌표
                xs = pts[:, 0] / OCR_SCALE
                ys = pts[:, 1] / OCR_SCALE

                bx1 = float(xs.min()) + x1
                by1 = float(ys.min()) + y1
                bx2 = float(xs.max()) + x1
                by2 = float(ys.max()) + y1

                bw = max(1.0, bx2 - bx1)
                bh = max(1.0, by2 - by1)

                candidate = {
                    "word": keyword,
                    "score": score,
                    "bbox_full": (
                        int(bx1),
                        int(by1),
                        int(bw),
                        int(bh)
                    ),
                    "center_full": (
                        int((bx1 + bx2) / 2.0),
                        int((by1 + by2) / 2.0)
                    )
                }

                # 같은 프레임에 여러 단어가 있으면 confidence가 높은 것 우선
                if best is None or score > best["score"]:
                    best = candidate

            if best is not None:

                with ocr_result_lock:
                    latest_ocr_target_full = best
                    latest_ocr_time = time.time()
                    latest_ocr_word = best["word"]
                    latest_ocr_score = best["score"]

                print(
                    f'[OCR] {best["word"]} '
                    f'{best["score"]:.2f}'
                )

        except Exception as e:
            # OCR 한 프레임 실패로 전체 주행 프로그램을 죽이지 않음
            print("[OCR] frame error:", e)

        time.sleep(0.01)


def choose_target(binary_target, ocr_target):
    """
    우선순위:
      1) 기존 이진화가 화살표를 잡았으면 화살표 우선
      2) AI OCR이 STOP/STATION/GOAL을 읽었으면 OCR 글씨
      3) 둘 다 아니면 기존 이진화 TEXT 사용

    즉 기존 화살표 로직은 건드리지 않고,
    멀리 있는 글씨만 AI가 보강한다.
    """
    if (
        binary_target is not None
        and binary_target.get("type") == "ARROW"
    ):
        return binary_target

    if ocr_target is not None:
        return ocr_target

    return binary_target


# ============================================================
# Visualization
# ============================================================

def draw_target(vis, target, ox, oy):
    if target is None:
        return

    x,y,w,h = target["bbox"]
    cx,cy = target["center"]

    if target["type"] == "ARROW":
        color = (255,0,0)

        # 실제 1픽셀 skeleton을 화면에 굵게 표시
        skel = target["skeleton"]

        if skel is not None:
            sy, sx = np.where(skel > 0)

            for px, py in zip(sx, sy):
                xx = int(px + ox)
                yy = int(py + oy)

                if (
                    1 <= yy < vis.shape[0]-1
                    and 1 <= xx < vis.shape[1]-1
                ):
                    cv2.circle(
                        vis,
                        (xx,yy),
                        1,
                        (255,0,0),
                        -1
                    )

        # 실제 주행에 사용하는 중심점
        cv2.circle(
            vis,
            (cx+ox,cy+oy),
            7,
            (0,0,255),
            -1
        )

    elif target["type"] == "OCR_TEXT":
        color = (0,165,255)

        cv2.circle(
            vis,
            (cx+ox,cy+oy),
            7,
            (0,0,255),
            -1
        )

    else:
        color = (255,0,255)

        cv2.circle(
            vis,
            (cx+ox,cy+oy),
            7,
            (0,0,255),
            -1
        )

    cv2.rectangle(
        vis,
        (x+ox,y+oy),
        (x+w+ox,y+h+oy),
        color,
        2
    )

    label = target.get("label", target["type"])

    if target.get("type") == "OCR_TEXT":
        score = target.get("score", 0.0)
        label = f"{label} {score:.2f}"

    cv2.putText(
        vis,
        label,
        (x+ox,max(20,y+oy-8)),
        cv2.FONT_HERSHEY_SIMPLEX,
        .55,
        color,
        2
    )

# ============================================================
# State machine
# ============================================================

def control_loop():
    global state, auto_mode, latest_jpeg
    global manual_until, manual_cmd
    global ir_armed, ir_clear_count
    global lost_count, last_target
    global ir_armed, ir_clear_count
    global ocr_submit_counter

    ir_stop_time = 0.0

    while not stop_event.is_set():

        frame = camera.get_frame()

        if frame is None:
            time.sleep(0.02)
            continue

        frame = cv2.flip(frame, -1) if False else frame.copy()

        h, w = frame.shape[:2]
        roi, ox, oy = get_roi(frame)
        white_mask, black_mask, road_region = make_masks(roi)

        # ----------------------------------------------------
        # 기존 이진화 target
        # ----------------------------------------------------
        binary_target = detect_target(black_mask)

        # ----------------------------------------------------
        # AI OCR용 프레임은 별도 thread에 전달
        # control loop 자체는 OCR을 기다리지 않음
        # ----------------------------------------------------
        ocr_submit_counter += 1

        if ocr_submit_counter >= OCR_SUBMIT_EVERY:
            submit_ocr_frame(frame)
            ocr_submit_counter = 0

        # 멀리 있는 STOP / STATION / GOAL AI OCR 결과
        ocr_target = get_live_ocr_target(ox, oy)

        # 화살표는 기존 방식 우선,
        # 글씨는 AI OCR로 보강
        target = choose_target(
            binary_target,
            ocr_target
        )

        ir_l, ir_c, ir_r = ir.read_ir()
        ir_hit = (
            ir_l >= IR_THRESHOLD or
            ir_c >= IR_THRESHOLD or
            ir_r >= IR_THRESHOLD
        )

        # ----------------------------------------------------
        # IR 재활성화 로직
        # 한 번 검은 표식에서 멈춘 직후에는 IR을 잠시 무시한다.
        # 로봇이 그 검은 표식에서 완전히 벗어나 센서가 연속 몇 프레임
        # "흰 바닥"을 본 뒤에만 다시 IR 감지를 활성화한다.
        # ----------------------------------------------------
        if not ir_armed:
            if not ir_hit:
                ir_clear_count += 1
            else:
                ir_clear_count = 0

            if ir_clear_count >= IR_CLEAR_FRAMES:
                ir_armed = True
                ir_clear_count = 0

        # --------------------------------
        # Manual override
        # --------------------------------
        if time.time() < manual_until and manual_cmd is not None:
            l, r = manual_cmd
            drive(l, r)

        elif not auto_mode:
            stop_robot()

        else:
            # ====================================================
            # START
            # 검은 목표가 보일 때까지 직진
            # ====================================================
            if state == "START":
                if target is None:
                    drive(STRAIGHT_SPEED, STRAIGHT_SPEED)
                else:
                    last_target = target
                    state = "ALIGN"

            # ====================================================
            # ALIGN
            # 화살표/글씨 중심을 화면 가운데로 정렬
            # ====================================================
            elif state == "ALIGN":
                if target is None:
                    lost_count += 1

                    if lost_count >= LOST_TARGET_FRAMES:
                        state = "SEARCH_RIGHT"
                        lost_count = 0
                else:
                    lost_count = 0
                    last_target = target

                    target_x = target["center"][0] + ox
                    error = target_x - (w/2)

                    if abs(error) <= CENTER_TOL:
                        stop_robot()
                        state = "FOLLOW"
                    else:
                        # 정렬은 제자리 회전
                        turn = int(np.clip(KP_ALIGN * error, -ALIGN_SPEED, ALIGN_SPEED))

                        if turn > 0:
                            drive(ALIGN_SPEED, -ALIGN_SPEED)
                        else:
                            drive(-ALIGN_SPEED, ALIGN_SPEED)

            # ====================================================
            # FOLLOW
            # 화살표는 skeleton 중심선 / 글씨는 bbox 중심 추종
            # ====================================================
            elif state == "FOLLOW":
                if ir_armed and ir_hit:
                    # IR이 검은 표식을 처음 감지하면 바로 멈추지 않고
                    # 1초간 더 직진하여 표식을 완전히 통과
                    ir_armed = False
                    ir_clear_count = 0
                    ir_stop_time = time.time()
                    state = "IR_CONTINUE"

                elif target is not None:
                    last_target = target
                    target_x = target["center"][0] + ox
                    error = target_x - (w/2)

                    p_drive(
                        error,
                        FOLLOW_SPEED,
                        KP_FOLLOW,
                        MAX_CORR
                    )

                else:
                    drive(FOLLOW_SPEED, FOLLOW_SPEED)

            elif state == "IR_CONTINUE":
                # 기존 검은 글씨/화살표를 벗어나기 위해
                # IR 감지 후 1초간 추가 직진
                if time.time() - ir_stop_time < IR_AFTER_HIT_DRIVE_SEC:
                    drive(FOLLOW_SPEED, FOLLOW_SPEED)
                else:
                    stop_robot()
                    ir_stop_time = time.time()
                    state = "IR_STOP"

            # ====================================================
            # IR STOP
            # 실제 목표 위 도착
            # ====================================================
            elif state == "IR_STOP":
                stop_robot()

                if time.time() - ir_stop_time >= IR_STOP_SEC:
                    # 1초 더 주행해서 이전 표식을 벗어난 뒤이므로
                    # 이전 OCR 결과를 비우고 다음 표식을 다시 탐색
                    clear_ocr_target()
                    state = "SEARCH_RIGHT"

            # ====================================================
            # SEARCH_RIGHT
            # 다음 목표가 안 보이면 오른쪽 제자리 회전
            # ====================================================
            elif state == "SEARCH_RIGHT":
                # 오른쪽으로 회전하면서 화살표 또는 글씨 둘 다 탐색
                if target is not None:
                    stop_robot()
                    last_target = target
                    lost_count = 0
                    state = "ALIGN"
                else:
                    drive(SEARCH_SPEED, -SEARCH_SPEED)

        # ========================================================
        # Draw
        # ========================================================
        vis = frame.copy()

        # ROI
        cv2.rectangle(
            vis,
            (ox,oy),
            (w-ox,h-1),
            (0,255,0),
            2
        )

        # screen center
        cv2.line(
            vis,
            (w//2,0),
            (w//2,h),
            (255,255,255),
            1
        )

        draw_target(vis, target, ox, oy)

        shown_state = state if auto_mode else f"PAUSED / {state}"

        cv2.putText(
            vis,
            f"STATE: {shown_state}",
            (12,28),
            cv2.FONT_HERSHEY_SIMPLEX,
            .65,
            (0,255,255),
            2
        )

        cv2.putText(
            vis,
            f"AUTO: {auto_mode}",
            (12,55),
            cv2.FONT_HERSHEY_SIMPLEX,
            .55,
            (0,255,255),
            2
        )

        cv2.putText(
            vis,
            f"IR L:{ir_l} C:{ir_c} R:{ir_r}",
            (12,82),
            cv2.FONT_HERSHEY_SIMPLEX,
            .50,
            (0,255,255),
            2
        )

        cv2.putText(
            vis,
            f"IR_ARMED: {ir_armed}",
            (12,108),
            cv2.FONT_HERSHEY_SIMPLEX,
            .48,
            (0,255,255),
            2
        )

        with ocr_result_lock:
            ocr_word_for_vis = latest_ocr_word
            ocr_score_for_vis = latest_ocr_score
            ocr_age_for_vis = (
                time.time() - latest_ocr_time
                if latest_ocr_time > 0
                else 999.0
            )

        if ocr_age_for_vis <= OCR_RESULT_TTL:
            ocr_text_for_vis = (
                f"OCR: {ocr_word_for_vis} "
                f"{ocr_score_for_vis:.2f}"
            )
        else:
            ocr_text_for_vis = "OCR: -"

        cv2.putText(
            vis,
            ocr_text_for_vis,
            (12,134),
            cv2.FONT_HERSHEY_SIMPLEX,
            .48,
            (0,165,255),
            2
        )

        # binary preview
        binary_bgr = cv2.cvtColor(black_mask, cv2.COLOR_GRAY2BGR)
        binary_bgr = cv2.resize(
            binary_bgr,
            (vis.shape[1], vis.shape[0]),
            interpolation=cv2.INTER_NEAREST
        )

        combo = np.hstack([vis, binary_bgr])

        ok, jpg = cv2.imencode(
            ".jpg",
            combo,
            [int(cv2.IMWRITE_JPEG_QUALITY), JPEG_QUALITY]
        )

        if ok:
            with jpeg_lock:
                latest_jpeg = jpg.tobytes()

        time.sleep(0.03)

