def clamp(v, lo=-100, hi=100):
    return max(lo, min(hi, int(v)))

def drive(left, right):
    left = clamp(left)
    right = clamp(right)
    motor.move(left, right)

def stop_robot():
    motor.move(0, 0)

def p_drive(error, base, kp, max_corr):
    corr = np.clip(kp * error, -max_corr, max_corr)
    left = base + corr
    right = base - corr
    drive(left, right)

