import cv2
import numpy as np
import time
import threading
from flask import Flask, Response, render_template_string
from pinkylib import Camera, Motor

# ==========================================
# 1. 하드웨어 및 파라미터 초기화
# ==========================================
app = Flask(__name__)

motor = Motor()
camera = Camera()

motor.enable_motor()
camera.start()

PORT = 5000
STRAIGHT_SPEED = 22
ALIGN_SPEED = 12
KP = 0.18
CENTER_TOLERANCE = 20
PASSED_DRIVE_TIME = 1.5

# road_test 색상 영역 설정
WHITE_LO = np.array([0, 0, 170], dtype=np.uint8)
WHITE_HI = np.array([180, 80, 255], dtype=np.uint8)
BLACK_LO = np.array([0, 0, 0], dtype=np.uint8)
BLACK_HI = np.array([180, 140, 110], dtype=np.uint8)

MIN_ARROW_AREA = 400
MAX_ARROW_AREA = 25000

state = "SEARCH"
auto_mode = False
stop_event = threading.Event()

latest_jpeg = None
jpeg_lock = threading.Lock()

def stop_robot():
    motor.move(0, 0)

# ==========================================
# 2. road_test 기반 이중 마스크 추출
# ==========================================
def make_masks(roi):
    hsv = cv2.cvtColor(roi, cv2.COLOR_BGR2HSV)

    white = cv2.inRange(hsv, WHITE_LO, WHITE_HI)
    black = cv2.inRange(hsv, BLACK_LO, BLACK_HI)

    k3 = np.ones((3, 3), np.uint8)
    k5 = np.ones((5, 5), np.uint8)

    white = cv2.morphologyEx(white, cv2.MORPH_OPEN, k3)
    white = cv2.morphologyEx(white, cv2.MORPH_CLOSE, k5)

    black = cv2.morphologyEx(black, cv2.MORPH_OPEN, k3)
    black = cv2.morphologyEx(black, cv2.MORPH_CLOSE, k3)

    road_region = np.zeros_like(white)
    contours, _ = cv2.findContours(white, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

    if contours:
        largest = max(contours, key=cv2.contourArea)
        if cv2.contourArea(largest) > 800:
            cv2.drawContours(road_region, [largest], -1, 255, -1)
            road_region = cv2.dilate(road_region, np.ones((7, 7), np.uint8), iterations=1)
        else:
            road_region[:] = 255
    else:
        road_region[:] = 255

    black = cv2.bitwise_and(black, road_region)
    return black

# ==========================================
# 3. 다각형 꼭짓점(Vertex) 분석 및 화살표 팁 추출
# ==========================================
def analyze_arrow_geometry(mask, roi_vis):
    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    
    best_tip = None
    best_cx = None
    best_cy = None

    for c in contours:
        area = cv2.contourArea(c)
        if not (MIN_ARROW_AREA <= area <= MAX_ARROW_AREA):
            continue

        peri = cv2.arcLength(c, True)
        approx = cv2.approxPolyDP(c, 0.035 * peri, True)
        num_vertices = len(approx)

        if 3 <= num_vertices <= 8:
            pts = approx.reshape(-1, 2)
            M = cv2.moments(c)
            if M["m00"] == 0:
                continue

            cx = int(M["m10"] / M["m00"])
            cy = int(M["m01"] / M["m00"])

            # 중심에서 가장 먼 꼭짓점을 화살표의 팁(Tip)으로 지정
            dists = [np.linalg.norm(pt - np.array([cx, cy])) for pt in pts]
            tip_idx = np.argmax(dists)
            tip_pt = tuple(pts[tip_idx])

            # 시각화 (선명한 두께로 표현)
            cv2.drawContours(roi_vis, [approx], -1, (255, 120, 0), 2)
            for pt in pts:
                cv2.circle(roi_vis, tuple(pt), 4, (0, 255, 0), -1)
            cv2.circle(roi_vis, tip_pt, 7, (0, 0, 255), -1)
            cv2.circle(roi_vis, (cx, cy), 4, (255, 0, 0), -1)

            best_tip = tip_pt
            best_cx = cx
            best_cy = cy
            break

    return best_tip, best_cx, best_cy

# ==========================================
# 4. 제어 및 고속 비전 연산 스레드
# ==========================================
def control_loop():
    global state, auto_mode, latest_jpeg

    pass_timer = 0.0

    while not stop_event.is_set():
        frame = camera.get_frame()
        if frame is None:
            time.sleep(0.005)
            continue

        h, w = frame.shape[:2]
        center_x = w // 2

        roi_y = int(h * 0.45)
        roi = frame[roi_y:h, 0:w]

        black_mask = make_masks(roi)
        tip_pt, cx, cy = analyze_arrow_geometry(black_mask, roi)

        target_x = tip_pt[0] if tip_pt is not None else cx

        # FSM 주행 로직
        if auto_mode:
            if state == "SEARCH":
                motor.move(STRAIGHT_SPEED, STRAIGHT_SPEED)
                if target_x is not None:
                    state = "ALIGN"

            elif state == "ALIGN":
                if target_x is None:
                    state = "SEARCH"
                else:
                    error = target_x - center_x
                    if abs(error) <= CENTER_TOLERANCE:
                        state = "FOLLOW"
                    else:
                        if error > 0:
                            motor.move(ALIGN_SPEED, -ALIGN_SPEED)
                        else:
                            motor.move(-ALIGN_SPEED, ALIGN_SPEED)

            elif state == "FOLLOW":
                if target_x is not None:
                    error = target_x - center_x
                    left_s = STRAIGHT_SPEED + int(error * KP)
                    right_s = STRAIGHT_SPEED - int(error * KP)
                    motor.move(left_s, right_s)
                else:
                    pass_timer = time.time()
                    state = "PASSED"

            elif state == "PASSED":
                if time.time() - pass_timer < PASSED_DRIVE_TIME:
                    motor.move(STRAIGHT_SPEED, STRAIGHT_SPEED)
                else:
                    state = "SEARCH"
        else:
            stop_robot()

        # 원본 해상도 유지 및 고화질(Quality 85) 인코딩
        cv2.line(frame, (center_x, 0), (center_x, h), (255, 255, 255), 1)
        status_text = f"AUTO: {'ON' if auto_mode else 'OFF'} | STATE: {state}"
        cv2.putText(frame, status_text, (12, 28), cv2.FONT_HERSHEY_SIMPLEX, 0.65, (0, 255, 255), 2)

        ok, jpg = cv2.imencode(".jpg", frame, [int(cv2.IMWRITE_JPEG_QUALITY), 85])
        if ok:
            with jpeg_lock:
                latest_jpeg = jpg.tobytes()

        time.sleep(0.01)  # 최대 ~100 FPS 연산 가능하도록 지연 대폭 축소

# ==========================================
# 5. 웹 스트리밍 인터페이스
# ==========================================
HTML = """
<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Pinky High-FPS Arrow Tracker</title>
<style>
body{background:#111;color:white;font-family:Arial;text-align:center;margin:0;padding:10px}
img{width:100%;max-width:800px;border:2px solid #555;border-radius:6px}
button{font-size:18px;margin:10px;padding:10px 24px;cursor:pointer}
</style>
</head>
<body>
<h2>Pinky High-Quality Vision Tracking</h2>
<img src="/video_feed"><br>
<button onclick="cmd('p')">START / PAUSE ('P')</button>
<button onclick="cmd('r')">RESET ('R')</button>

<script>
function cmd(k){ fetch('/cmd/'+k); }
document.addEventListener('keydown', function(e){
    if(e.repeat) return;
    let k = e.key.toLowerCase();
    if(k === 'p' || k === 'r'){ cmd(k); }
});
</script>
</body>
</html>
"""

@app.route("/")
def index():
    return render_template_string(HTML)

def mjpeg():
    while True:
        with jpeg_lock:
            data = latest_jpeg
        if data is not None:
            yield (b'--frame\r\n'
                   b'Content-Type: image/jpeg\r\n\r\n' + data + b'\r\n')
        time.sleep(0.015)

@app.route("/video_feed")
def video_feed():
    return Response(mjpeg(), mimetype='multipart/x-mixed-replace; boundary=frame')

@app.route("/cmd/<key>")
def command(key):
    global auto_mode, state
    if key == "p":
        auto_mode = not auto_mode
        state = "SEARCH" if auto_mode else state
        if not auto_mode: stop_robot()
    elif key == "r":
        auto_mode = False
        state = "SEARCH"
        stop_robot()
    return "OK"

if __name__ == "__main__":
    threading.Thread(target=control_loop, daemon=True).start()

    print("==================================================")
    print(" [고해상도/고프레임 비전 주행 서버 실행]")
    print(f" 접속 주소: http://<라즈베리파이_IP>:{PORT}")
    print("==================================================")

    try:
        app.run(host="0.0.0.0", port=PORT, threaded=True, debug=False)
    finally:
        stop_event.set()
        stop_robot()
        camera.stop()
