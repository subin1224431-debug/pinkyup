import cv2
import numpy as np
import time
import threading
from flask import Flask, Response, render_template_string
from pinkylib import Camera, Motor

# ==========================================
# 1. 하드웨어 및 웹 서버 초기화
# ==========================================
app = Flask(__name__)

motor = Motor()
camera = Camera()

motor.enable_motor()
camera.start()

# 주행 제어 파라미터
PORT = 5000
STRAIGHT_SPEED = 22
ALIGN_SPEED = 12
KP = 0.15
CENTER_TOLERANCE = 25
PASSED_DRIVE_TIME = 1.5

# 상태 및 동기화 변수
state = "SEARCH"
auto_mode = False
stop_event = threading.Event()

latest_jpeg = None
jpeg_lock = threading.Lock()

def stop_robot():
    motor.move(0, 0)

# ==========================================
# 2. 비전 처리 및 주행 FSM 제어 루프 (스레드)
# ==========================================
def control_loop():
    global state, auto_mode, latest_jpeg

    pass_timer = 0.0

    while not stop_event.is_set():
        frame = camera.get_frame()
        if frame is None:
            time.sleep(0.01)
            continue

        h, w = frame.shape[:2]
        center_x = w // 2

        # 하단 50% ROI 설정
        roi_y = int(h * 0.5)
        roi = frame[roi_y:h, 0:w]

        # 검은색 화살표 추출
        hsv = cv2.cvtColor(roi, cv2.COLOR_BGR2HSV)
        lower_black = np.array([0, 0, 0])
        upper_black = np.array([180, 255, 75])

        mask = cv2.inRange(hsv, lower_black, upper_black)
        kernel = np.ones((5, 5), np.uint8)
        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)
        mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel)

        contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

        target_cx = None
        target_cy = None

        if contours:
            largest_c = max(contours, key=cv2.contourArea)
            if cv2.contourArea(largest_c) > 600:
                M = cv2.moments(largest_c)
                if M["m00"] != 0:
                    target_cx = int(M["m10"] / M["m00"])
                    target_cy = int(M["m01"] / M["m00"])

                    # 시각화 데이터 그리기
                    cv2.circle(roi, (target_cx, target_cy), 6, (0, 0, 255), -1)
                    cv2.drawContours(roi, [largest_c], -1, (0, 255, 0), 2)

        # ------------------------------------------
        # FSM 주행 상태 머신
        # ------------------------------------------
        if auto_mode:
            # 1) SEARCH: 화살표를 찾을 때까지 직진
            if state == "SEARCH":
                motor.move(STRAIGHT_SPEED, STRAIGHT_SPEED)
                if target_cx is not None:
                    state = "ALIGN"

            # 2) ALIGN: 화살표 중심에 맞추어 제자리 정렬
            elif state == "ALIGN":
                if target_cx is None:
                    state = "SEARCH"
                else:
                    error = target_cx - center_x
                    if abs(error) <= CENTER_TOLERANCE:
                        state = "FOLLOW"
                    else:
                        if error > 0:
                            motor.move(ALIGN_SPEED, -ALIGN_SPEED)
                        else:
                            motor.move(-ALIGN_SPEED, ALIGN_SPEED)

            # 3) FOLLOW: 화살표를 조향하며 진입
            elif state == "FOLLOW":
                if target_cx is not None:
                    error = target_cx - center_x
                    left_s = STRAIGHT_SPEED + int(error * KP)
                    right_s = STRAIGHT_SPEED - int(error * KP)
                    motor.move(left_s, right_s)
                else:
                    pass_timer = time.time()
                    state = "PASSED"

            # 4) PASSED: 통과 후 일정 시간 직진 후 다음 화살표 탐색
            elif state == "PASSED":
                if time.time() - pass_timer < PASSED_DRIVE_TIME:
                    motor.move(STRAIGHT_SPEED, STRAIGHT_SPEED)
                else:
                    state = "SEARCH"

        else:
            stop_robot()

        # ------------------------------------------
        # 웹 스트리밍용 영상 합성
        # ------------------------------------------
        vis = frame.copy()
        cv2.line(vis, (center_x, 0), (center_x, h), (255, 255, 255), 1)

        status_text = f"AUTO: {'ON' if auto_mode else 'OFF'} | STATE: {state}"
        cv2.putText(vis, status_text, (12, 28), cv2.FONT_HERSHEY_SIMPLEX, 0.65, (0, 255, 255), 2)

        ok, jpg = cv2.imencode(".jpg", vis, [int(cv2.IMWRITE_JPEG_QUALITY), 60])
        if ok:
            with jpeg_lock:
                latest_jpeg = jpg.tobytes()

        time.sleep(0.03)

# ==========================================
# 3. Flask 웹 인터페이스 및 스트리밍
# ==========================================
HTML = """
<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Pinky Arrow Navigation</title>
<style>
body{background:#111;color:white;font-family:Arial;text-align:center}
img{width:90%;max-width:1000px;border:2px solid #555}
button{font-size:20px;margin:10px;padding:10px 20px}
</style>
</head>
<body>
<h2>Pinky Arrow Sequence Navigation</h2>
<img src="/video_feed"><br>
<button onclick="cmd('p')">START / PAUSE ('P')</button>
<button onclick="cmd('r')">RESET ('R')</button>

<script>
function cmd(k){ fetch('/cmd/'+k); }

document.addEventListener('keydown', function(e){
    if(e.repeat) return;
    let k = e.key.toLowerCase();
    if(k === 'p' || k === 'r'){
        cmd(k);
    }
});
</script>
</body>
</html>
"""

@app.route("/")
def index():
    return render_template_string(HTML)

def mjpeg():
    while True:
        with jpeg_lock:
            data = latest_jpeg
        if data is not None:
            yield (b'--frame\r\n'
                   b'Content-Type: image/jpeg\r\n\r\n' + data + b'\r\n')
        time.sleep(0.04)

@app.route("/video_feed")
def video_feed():
    return Response(mjpeg(), mimetype='multipart/x-mixed-replace; boundary=frame')

@app.route("/cmd/<key>")
def command(key):
    global auto_mode, state
    if key == "p":
        auto_mode = not auto_mode
        state = "SEARCH" if auto_mode else state
        if not auto_mode:
            stop_robot()
    elif key == "r":
        auto_mode = False
        state = "SEARCH"
        stop_robot()
    return "OK"

# ==========================================
# 4. 메인 실행
# ==========================================
if __name__ == "__main__":
    threading.Thread(target=control_loop, daemon=True).start()

    print("==================================================")
    print(" [Pinky 비전 웹 주행 서버 시작]")
    print(f" 접속 주소: http://<라즈베리파이_IP>:{PORT}")
    print(" 웹페이지 열린 상태에서 키보드 'p' 누르면 자동 주행 시작")
    print("==================================================")

    try:
        app.run(host="0.0.0.0", port=PORT, threaded=True, debug=False)
    finally:
        stop_event.set()
        stop_robot()
        camera.stop()
