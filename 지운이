import cv2
import numpy as np
import time
from pinkylib import Camera, Motor

# ==========================================
# 1. 하드웨어 초기화 (기본 설정 연동)
# ==========================================
motor = Motor()
camera = Camera()

motor.enable_motor()
camera.start()

# 주행 파라미터 설정
BASE_SPEED = 22
KP = 0.15  # 조향 민감도 (필요에 따라 조절)

auto_mode = False

print("프로그램이 시작되었습니다. 카메라 창을 클릭하고 'p'를 누르면 주행을 시작합니다.")
print("종료하려면 'q'를 누르세요.")

try:
    while True:
        frame = camera.get_frame()
        if frame is None:
            time.sleep(0.01)
            continue
            
        h, w = frame.shape[:2]
        
        # ==========================================
        # 2. 화살표 인식 영역(ROI) 설정 (화면 아래쪽 50%)
        # ==========================================
        roi_y = int(h * 0.5)
        roi = frame[roi_y:h, 0:w]
        
        # ==========================================
        # 3. 색상 기반 화살표(검은색) 검출
        # ==========================================
        hsv = cv2.cvtColor(roi, cv2.COLOR_BGR2HSV)
        
        # 검은색 범위 지정 (조명에 따라 값 조정 필요)
        lower_black = np.array([0, 0, 0])
        upper_black = np.array([180, 255, 70])
        
        mask = cv2.inRange(hsv, lower_black, upper_black)
        
        # 노이즈 제거 (모폴로지 연산)
        kernel = np.ones((5,5), np.uint8)
        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)
        mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel)
        
        # ==========================================
        # 4. 화살표 중심점 계산 및 방향 조절
        # ==========================================
        contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        
        if contours:
            # 가장 큰 윤곽선 찾기 (화살표로 간주)
            largest_c = max(contours, key=cv2.contourArea)
            
            if cv2.contourArea(largest_c) > 500:  # 너무 작은 노이즈 무시
                # 윤곽선의 무게 중심(Centroid) 계산
                M = cv2.moments(largest_c)
                if M["m00"] != 0:
                    cx = int(M["m10"] / M["m00"])
                    cy = int(M["m01"] / M["m00"])
                    
                    # 화면 중앙(w/2)과 화살표 중심(cx)의 오차 계산
                    error = cx - (w // 2)
                    
                    # 시각화: 중심점에 빨간 원 그리기
                    cv2.circle(roi, (cx, cy), 5, (0, 0, 255), -1)
                    cv2.drawContours(roi, [largest_c], -1, (0, 255, 0), 2)
                    
                    # 주행 모드일 때 모터 제어 (화살표 중심을 향해 회전)
                    if auto_mode:
                        left_speed = BASE_SPEED + int(error * KP)
                        right_speed = BASE_SPEED - int(error * KP)
                        
                        # 모터 속도 제한 (-100 ~ 100)
                        left_speed = max(min(left_speed, 100), -100)
                        right_speed = max(min(right_speed, 100), -100)
                        
                        motor.move(left_speed, right_speed)
                else:
                    if auto_mode: motor.move(BASE_SPEED, BASE_SPEED)
            else:
                if auto_mode: motor.move(BASE_SPEED, BASE_SPEED)
        else:
            if auto_mode: motor.move(BASE_SPEED, BASE_SPEED)

        # ==========================================
        # 5. 화면 출력 및 단축키 제어
        # ==========================================
        status_text = "AUTO: ON" if auto_mode else "AUTO: OFF (Press 'p')"
        color = (0, 255, 0) if auto_mode else (0, 0, 255)
        cv2.putText(frame, status_text, (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, color, 2)
        
        cv2.imshow("Robot View", frame)
        cv2.imshow("Arrow Mask", mask)
        
        # 'p' 키를 누르면 주행/정지 토글 (반드시 cv2 영상 창이 선택된 상태에서 눌러야 함)
        key = cv2.waitKey(1) & 0xFF
        if key == ord('p'):
            auto_mode = not auto_mode
            if not auto_mode:
                motor.move(0, 0)
                print("주행 정지")
            else:
                print("자동 주행 시작")
        elif key == ord('q'):
            print("프로그램 종료")
            break

finally:
    motor.move(0, 0)
    camera.stop()
    cv2.destroyAllWindows()
