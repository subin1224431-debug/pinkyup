import cv2
import numpy as np
import time
import threading
from flask import Flask, Response, render_template_string
from pinkylib import Camera, Motor

# ==========================================
# 1. 하드웨어 및 파라미터 초기화
# ==========================================
app = Flask(__name__)

motor = Motor()
camera = Camera()

motor.enable_motor()
camera.start()

PORT = 5000
STRAIGHT_SPEED = 22
ALIGN_SPEED = 12
TURN_SPEED = 20
KP = 0.18
CENTER_TOLERANCE = 20
PASSED_DRIVE_TIME = 1.2
INTERSECTION_TURN_TIME = 1.2  # 교차로 우회전 진입 시간(초)

# road_test 기반 색상 이진화 범위[cite: 1]
WHITE_LO = np.array([0, 0, 170], dtype=np.uint8)
WHITE_HI = np.array([180, 80, 255], dtype=np.uint8)
BLACK_LO = np.array([0, 0, 0], dtype=np.uint8)
BLACK_HI = np.array([180, 140, 110], dtype=np.uint8)

MIN_ARROW_AREA = 400
MAX_ARROW_AREA = 25000

# 상태 및 카운터 변수
state = "SEARCH"
auto_mode = False
arrow_count = 0
stop_event = threading.Event()

latest_jpeg = None
jpeg_lock = threading.Lock()

def stop_robot():
    motor.move(0, 0)

# ==========================================
# 2. 마스크 추출 및 비전 분석
# ==========================================
def make_masks(roi):
    hsv = cv2.cvtColor(roi, cv2.COLOR_BGR2HSV)
    white = cv2.inRange(hsv, WHITE_LO, WHITE_HI)
    black = cv2.inRange(hsv, BLACK_LO, BLACK_HI)

    k3 = np.ones((3, 3), np.uint8)
    k5 = np.ones((5, 5), np.uint8)

    white = cv2.morphologyEx(white, cv2.MORPH_OPEN, k3)
    white = cv2.morphologyEx(white, cv2.MORPH_CLOSE, k5)

    black = cv2.morphologyEx(black, cv2.MORPH_OPEN, k3)
    black = cv2.morphologyEx(black, cv2.MORPH_CLOSE, k3)

    road_region = np.zeros_like(white)
    contours, _ = cv2.findContours(white, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

    if contours:
        largest = max(contours, key=cv2.contourArea)
        if cv2.contourArea(largest) > 800:
            cv2.drawContours(road_region, [largest], -1, 255, -1)
            road_region = cv2.dilate(road_region, np.ones((7, 7), np.uint8), iterations=1)
        else:
            road_region[:] = 255
    else:
        road_region[:] = 255

    black = cv2.bitwise_and(black, road_region)
    return black

def analyze_arrow_geometry(mask, roi_vis):
    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    
    best_tip = None
    best_cx = None
    best_cy = None

    for c in contours:
        area = cv2.contourArea(c)
        if not (MIN_ARROW_AREA <= area <= MAX_ARROW_AREA):
            continue

        peri = cv2.arcLength(c, True)
        approx = cv2.approxPolyDP(c, 0.035 * peri, True)
        num_vertices = len(approx)

        if 3 <= num_vertices <= 8:
            pts = approx.reshape(-1, 2)
            M = cv2.moments(c)
            if M["m00"] == 0:
                continue

            cx = int(M["m10"] / M["m00"])
            cy = int(M["m01"] / M["m00"])

            dists = [np.linalg.norm(pt - np.array([cx, cy])) for pt in pts]
            tip_idx = np.argmax(dists)
            tip_pt = tuple(pts[tip_idx])

            cv2.drawContours(roi_vis, [approx], -1, (255, 120, 0), 2)
            cv2.circle(roi_vis, tip_pt, 7, (0, 0, 255), -1)

            best_tip = tip_pt
            best_cx = cx
            best_cy = cy
            break

    return best_tip, best_cx, best_cy

def detect_stop_right(frame):
    """오른쪽 시야(Right ROI)에 나타나는 STOP 글씨 감지"""
    h, w = frame.shape[:2]
    # 우측 35% 영역 지정
    right_roi = frame[int(h * 0.25):int(h * 0.8), int(w * 0.65):w]
    
    hsv = cv2.cvtColor(right_roi, cv2.COLOR_BGR2HSV)
    black_mask = cv2.inRange(hsv, BLACK_LO, BLACK_HI)
    
    contours, _ = cv2.findContours(black_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    
    for c in contours:
        area = cv2.contourArea(c)
        if 300 <= area <= 10000:
            x, y, bw, bh = cv2.boundingRect(c)
            aspect_ratio = float(bw) / bh
            # 글씨 패널 특성 (가로가 긴 사각형 비율)
            if 1.2 <= aspect_ratio <= 4.5:
                # 시각화 박스 그리기
                cv2.rectangle(right_roi, (x, y), (x + bw, y + bh), (0, 255, 255), 2)
                cv2.putText(right_roi, "STOP", (x, y - 5), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 255), 2)
                return True
    return False

# ==========================================
# 3. FSM 제어 루프
# ==========================================
def control_loop():
    global state, auto_mode, arrow_count, latest_jpeg

    pass_timer = 0.0
    turn_timer = 0.0

    while not stop_event.is_set():
        frame = camera.get_frame()
        if frame is None:
            time.sleep(0.005)
            continue

        h, w = frame.shape[:2]
        center_x = w // 2

        roi_y = int(h * 0.45)
        roi = frame[roi_y:h, 0:w]

        black_mask = make_masks(roi)
        tip_pt, cx, cy = analyze_arrow_geometry(black_mask, roi)

        target_x = tip_pt[0] if tip_pt is not None else cx
        stop_detected = detect_stop_right(frame)

        # ------------------------------------------
        # 화살표 카운트 및 FSM 제어 로직
        # ------------------------------------------
        if auto_mode:
            # 1) 일반 탐색
            if state == "SEARCH":
                motor.move(STRAIGHT_SPEED, STRAIGHT_SPEED)
                if target_x is not None:
                    state = "ALIGN"

            # 2) 화살표 방향 정렬
            elif state == "ALIGN":
                if target_x is None:
                    state = "SEARCH"
                else:
                    error = target_x - center_x
                    if abs(error) <= CENTER_TOLERANCE:
                        state = "FOLLOW"
                    else:
                        if error > 0:
                            motor.move(ALIGN_SPEED, -ALIGN_SPEED)
                        else:
                            motor.move(-ALIGN_SPEED, ALIGN_SPEED)

            # 3) 화살표 추종 주행
            elif state == "FOLLOW":
                if target_x is not None:
                    error = target_x - center_x
                    left_s = STRAIGHT_SPEED + int(error * KP)
                    right_s = STRAIGHT_SPEED - int(error * KP)
                    motor.move(left_s, right_s)
                else:
                    pass_timer = time.time()
                    state = "PASSED"

            # 4) 통과 및 화살표 카운팅
            elif state == "PASSED":
                if time.time() - pass_timer < PASSED_DRIVE_TIME:
                    motor.move(STRAIGHT_SPEED, STRAIGHT_SPEED)
                else:
                    arrow_count += 1
                    print(f"-> 화살표 通過 완료! 현재 카운트: {arrow_count}")
                    
                    # 2번째 화살표를 지난 직후에는 6번 화살표를 탐색하지 않고 STOP 탐색 단계로 이동
                    if arrow_count == 2:
                        state = "SEARCH_STOP"
                    else:
                        state = "SEARCH"

            # 5) 2번 화살표 통과 후 오른쪽 STOP 글씨 감지 대기
            elif state == "SEARCH_STOP":
                motor.move(STRAIGHT_SPEED, STRAIGHT_SPEED)
                if stop_detected:
                    print("-> 오른쪽 STOP 글씨 감지! 교차로 우회전 진입 시작")
                    turn_timer = time.time()
                    state = "ENTER_INTERSECTION"

            # 6) 교차로 내부 우회전 진입
            elif state == "ENTER_INTERSECTION":
                if time.time() - turn_timer < INTERSECTION_TURN_TIME:
                    motor.move(TURN_SPEED, -TURN_SPEED)  # 오른쪽으로 제자리 회전하여 교차로 진입
                else:
                    state = "SEARCH"

        else:
            stop_robot()

        # ------------------------------------------
        # 화면 HUD 시각화
        # ------------------------------------------
        cv2.line(frame, (center_x, 0), (center_x, h), (255, 255, 255), 1)
        # 오른쪽 탐색 ROI 박스 시각화
        cv2.rectangle(frame, (int(w * 0.65), int(h * 0.25)), (w, int(h * 0.8)), (255, 255, 0), 1)

        status_text = f"AUTO: {'ON' if auto_mode else 'OFF'} | ARROW: {arrow_count} | STATE: {state}"
        cv2.putText(frame, status_text, (12, 28), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 255), 2)

        ok, jpg = cv2.imencode(".jpg", frame, [int(cv2.IMWRITE_JPEG_QUALITY), 85])
        if ok:
            with jpeg_lock:
                latest_jpeg = jpg.tobytes()

        time.sleep(0.01)

# ==========================================
# 4. 웹 UI 컨트롤러
# ==========================================
HTML = """
<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Pinky Intersection Navigation</title>
<style>
body{background:#111;color:white;font-family:Arial;text-align:center;margin:0;padding:10px}
img{width:100%;max-width:850px;border:2px solid #555;border-radius:6px}
button{font-size:18px;margin:10px;padding:10px 24px;cursor:pointer}
</style>
</head>
<body>
<h2>Pinky Intersection STOP Detection</h2>
<img src="/video_feed"><br>
<button onclick="cmd('p')">START / PAUSE ('P')</button>
<button onclick="cmd('r')">RESET ('R')</button>

<script>
function cmd(k){ fetch('/cmd/'+k); }
document.addEventListener('keydown', function(e){
    if(e.repeat) return;
    let k = e.key.toLowerCase();
    if(k === 'p' || k === 'r'){ cmd(k); }
});
</script>
</body>
</html>
"""

@app.route("/")
def index():
    return render_template_string(HTML)

def mjpeg():
    while True:
        with jpeg_lock:
            data = latest_jpeg
        if data is not None:
            yield (b'--frame\r\n'
                   b'Content-Type: image/jpeg\r\n\r\n' + data + b'\r\n')
        time.sleep(0.015)

@app.route("/video_feed")
def video_feed():
    return Response(mjpeg(), mimetype='multipart/x-mixed-replace; boundary=frame')

@app.route("/cmd/<key>")
def command(key):
    global auto_mode, state, arrow_count
    if key == "p":
        auto_mode = not auto_mode
        if not auto_mode: stop_robot()
    elif key == "r":
        auto_mode = False
        arrow_count = 0
        state = "SEARCH"
        stop_robot()
    return "OK"

if __name__ == "__main__":
    threading.Thread(target=control_loop, daemon=True).start()

    print("==================================================")
    print(" [교차로 STOP 감지 & 화살표 카운팅 주행 서버 실행]")
    print(f" 접속 주소: http://<라즈베리파이_IP>:{PORT}")
    print("==================================================")

    try:
        app.run(host="0.0.0.0", port=PORT, threaded=True, debug=False)
    finally:
        stop_event.set()
        stop_robot()
        camera.stop()
